# Bagelbite web app configuration (Vite reads VITE_* at build time).
# Local dev: copy to frontend/.env.development.local. Production: set in Vercel project settings.

# URL of the Bagelbite API (Railway in production).
VITE_API_URL=http://localhost:8787

# firebase (default) or dev (labelled dev sign-in; pairs with the API's AUTH_MODE=dev).
VITE_AUTH_MODE=dev

# Firebase web app config (Firebase console → Project settings → Your apps). Required unless dev mode.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your-project
# VITE_FIREBASE_APP_ID=

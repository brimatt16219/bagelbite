# Bagelbite API configuration. Copy to backend/.env for local development.
# In production (Railway) set these as service variables instead. Every value is validated at
# startup (src/config.ts); dev-only settings are refused when NODE_ENV=production.

NODE_ENV=development
PORT=8787

# --- Database -------------------------------------------------------------------------------
# Postgres connection string (Railway provides DATABASE_URL). Required in production.
# Leave unset locally to use embedded PGlite (real Postgres compiled to WASM) at PGLITE_DATA_DIR.
# DATABASE_URL=postgresql://user:password@host:5432/bagelbite
PGLITE_DATA_DIR=.data/pglite

# Comma-separated browser origins allowed to call the API (your Vercel URL in production).
# Outside production any http://localhost:<port> origin is also allowed.
CORS_ORIGINS=http://localhost:5173

# --- Auth -----------------------------------------------------------------------------------
# firebase (default): verify Firebase ID tokens. dev: accept "dev:<name>" tokens — local only.
AUTH_MODE=dev
# Required when AUTH_MODE=firebase:
# FIREBASE_PROJECT_ID=your-firebase-project
# Service-account JSON (raw or base64). Optional when the host has Google default credentials.
# FIREBASE_SERVICE_ACCOUNT_JSON=

# --- AI (Anthropic Claude) ------------------------------------------------------------------
# anthropic (default) or offline (labelled template content for keyless local dev only).
LLM_PROVIDER=offline
# ANTHROPIC_API_KEY=sk-ant-...
# Generation, verification and the chat tutor; grading uses the cheaper model (see vault Cost-Model).
CLAUDE_MODEL_GENERATION=claude-sonnet-5
CLAUDE_MODEL_GRADING=claude-haiku-4-5

# --- Grounding (Tavily) ---------------------------------------------------------------------
# tavily (default): search sources before generating medium/high-risk lessons (required in production).
# off: local dev only — such lessons are marked "not source-grounded".
GROUNDING=off
# TAVILY_API_KEY=tvly-...

# Server-side spec validation of generated exercises (sandboxed). Must stay true in production.
EXERCISE_VALIDATION=true
